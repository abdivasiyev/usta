cabal-version: 3.14
name: usta
version: 0.1.0.0
synopsis: A native desktop client for code forges
license: Apache-2.0
license-file: LICENSE
author: Asliddin Abdivasiyev
maintainer: asliddin.abdivasiyev@gmail.com
category: Development
build-type: Simple

executable usta
  main-is: Main.hs
  hs-source-dirs:
    app
    src

  other-modules:
    Usta.Accounts
    Usta.Bus
    Usta.DB
    Usta.DB.Account
    Usta.DB.Issue
    Usta.DB.Mirror
    Usta.DB.Notification
    Usta.DB.PullRequest
    Usta.DB.Repository
    Usta.DB.Schema
    Usta.DB.Schema.Account
    Usta.DB.Schema.Issue
    Usta.DB.Schema.IssueInvolvement
    Usta.DB.Schema.IssueLabel
    Usta.DB.Schema.Mirror
    Usta.DB.Schema.Notification
    Usta.DB.Schema.PullRequest
    Usta.DB.Schema.PullRequestInvolvement
    Usta.DB.Schema.Repository
    Usta.DB.Schema.SyncCursor
    Usta.DB.SyncCursor
    Usta.Details
    Usta.Forge
    Usta.Forge.Forgejo
    Usta.Forge.Forgejo.Api
    Usta.Forge.Http
    Usta.Forge.Sample
    Usta.Git
    Usta.Git.Credential
    Usta.Keyring
    Usta.Mirrors
    Usta.Sync
    Usta.Types.Account
    Usta.Types.Commit
    Usta.Types.Count
    Usta.Types.Diff
    Usta.Types.ETag
    Usta.Types.Forge
    Usta.Types.Host
    Usta.Types.Involvement
    Usta.Types.Issue
    Usta.Types.Label
    Usta.Types.Login
    Usta.Types.Mirror
    Usta.Types.Notification
    Usta.Types.Number
    Usta.Types.Parse
    Usta.Types.Platform
    Usta.Types.PullRequest
    Usta.Types.Ref
    Usta.Types.RepoName
    Usta.Types.Repository
    Usta.Types.Resource
    Usta.Types.Servant.NamedQueryParam
    Usta.Types.ThreadId
    Usta.Types.Token
    Usta.UI.Components.Avatar
    Usta.UI.Components.Badge
    Usta.UI.Components.Button
    Usta.UI.Components.Card
    Usta.UI.Components.CommandPalette
    Usta.UI.Components.Diff
    Usta.UI.Components.Forge
    Usta.UI.Components.Icon
    Usta.UI.Components.MarkdownEditor
    Usta.UI.Components.NavItem
    Usta.UI.Components.Progress
    Usta.UI.Components.SearchField
    Usta.UI.Components.Segmented
    Usta.UI.Components.Shortcut
    Usta.UI.Components.Skeleton
    Usta.UI.Components.SyncStatus
    Usta.UI.Format
    Usta.UI.Gallery
    Usta.UI.Page
    Usta.UI.Pages.AddAccount
    Usta.UI.Pages.Inbox
    Usta.UI.Pages.Issue
    Usta.UI.Pages.Issues
    Usta.UI.Pages.NewIssue
    Usta.UI.Pages.NewPullRequest
    Usta.UI.Pages.PullRequest
    Usta.UI.Pages.PullRequest.Checks
    Usta.UI.Pages.PullRequest.Commits
    Usta.UI.Pages.PullRequest.Conversation
    Usta.UI.Pages.PullRequest.Files
    Usta.UI.Pages.PullRequests
    Usta.UI.Pages.Repositories
    Usta.UI.Pages.Settings
    Usta.UI.Pages.Welcome
    Usta.UI.Platform
    Usta.UI.Sidebar
    Usta.UI.Source
    Usta.UI.Style
    Usta.UI.Window

  build-depends:
    aeson,
    async,
    base,
    bytestring,
    containers,
    directory,
    esqueleto,
    filepath,
    gi-glib,
    gi-gtk4,
    gi-pango,
    haskell-gi-base,
    http-api-data,
    http-client,
    http-client-tls,
    http-types,
    monad-logger,
    persistent,
    persistent-sqlite,
    resourcet,
    servant,
    servant-client,
    servant-client-core,
    stm,
    text,
    time,
    typed-process

  default-language: GHC2024
  default-extensions:
    DuplicateRecordFields
    NoFieldSelectors
    OverloadedRecordDot
  ghc-options: -Wall -threaded
  c-sources: cbits/keyring.c

  if os(darwin)
    frameworks:
      CoreFoundation
      Security
  else
    pkgconfig-depends: libsecret-1
