    Usta.UI.HighlightTests
    Usta.UI.Pages.PullRequest.ChecksTests
    Usta.UpdatesTests
  ghc-options: -threaded
  build-depends:
    aeson,
    aeson-pretty,
    base,
    base64-bytestring,
    bytestring,
    case-insensitive,
    containers,
    cryptohash-sha256,
