    cbits/appearance.c
    cbits/keyring.c
    cbits/notify.c
    cbits/urls.c
    cbits/windows.c

  if os(darwin)
    frameworks:
      CoreFoundation
      CoreServices
      Security
      UserNotifications
  else
    pkgconfig-depends: libsecret-1

executable usta
  import: language
  main-is: Main.hs
  hs-source-dirs: app
  ghc-options: -threaded
  build-depends:
    base,
    directory,
    filepath,
    gi-gio,
    gi-gtk4,
    haskell-gi-base,
    http-client,
    http-client-tls,
    persistent,
    text,
    time,
    usta

test-suite usta-test
  import: language
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  other-modules:
    Usta.AccountsTests
    Usta.CacheTests
    Usta.Contract.ForgeTests
    Usta.Contract.Replay
    Usta.DiagramTests
    Usta.GitTests
    Usta.GraphTests
