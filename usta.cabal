  default-language: GHC2024
  default-extensions:
    DuplicateRecordFields
    NoFieldSelectors
    OverloadedRecordDot
  ghc-options: -Wall -threaded
  c-sources:
    cbits/appearance.c
    cbits/keyring.c

  if os(darwin)
    frameworks:
      CoreFoundation
      Security
  else
    pkgconfig-depends: libsecret-1
