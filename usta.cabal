cabal-version: 3.14
name: usta
version: 0.1.0
synopsis: A native desktop client for code forges
license: Apache-2.0
license-file: LICENSE
author: Asliddin Abdivasiyev
maintainer: asliddin.abdivasiyev@gmail.com
category: Development
build-type: Simple
extra-source-files:
