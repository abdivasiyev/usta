cabal-version: 3.14
name: usta
version: 0.1.0.0
synopsis: A native desktop client for code forges
license: Apache-2.0
license-file: LICENSE
author: Asliddin Abdivasiyev
maintainer: asliddin.abdivasiyev@gmail.com
category: Development
build-type: Simple

executable usta
  main-is: Main.hs
  hs-source-dirs:
    app
    src

  other-modules:
    Usta.DB.Schema.Account
    Usta.DB.Schema.Issue
    Usta.DB.Schema.IssueInvolvement
    Usta.DB.Schema.IssueLabel
    Usta.DB.Schema.Notification
    Usta.DB.Schema.PullRequest
    Usta.DB.Schema.PullRequestInvolvement
    Usta.DB.Schema.Repository
    Usta.Types.Account
    Usta.Types.Forge
    Usta.Types.Host
    Usta.Types.Involvement
    Usta.Types.Issue
    Usta.Types.Label
    Usta.Types.Login
    Usta.Types.Notification
    Usta.Types.Number
    Usta.Types.Parse
    Usta.Types.PullRequest
    Usta.Types.Ref
    Usta.Types.RepoName
    Usta.Types.Repository
    Usta.Types.ThreadId
    Usta.Types.Token
    Usta.UI.Components.Avatar
    Usta.UI.Components.Badge
    Usta.UI.Components.Button
    Usta.UI.Components.Card
    Usta.UI.Components.CommandPalette
    Usta.UI.Components.Diff
    Usta.UI.Components.Forge
    Usta.UI.Components.Icon
    Usta.UI.Components.MarkdownEditor
    Usta.UI.Components.NavItem
    Usta.UI.Components.Progress
    Usta.UI.Components.SearchField
    Usta.UI.Components.Segmented
    Usta.UI.Components.Shortcut
    Usta.UI.Components.Skeleton
    Usta.UI.Components.SyncStatus
    Usta.UI.Gallery
    Usta.UI.Pages.AddAccount
    Usta.UI.Pages.Inbox
    Usta.UI.Pages.Issue
    Usta.UI.Pages.Issues
    Usta.UI.Pages.NewIssue
    Usta.UI.Pages.NewPullRequest
    Usta.UI.Pages.PullRequest
    Usta.UI.Pages.PullRequest.Checks
    Usta.UI.Pages.PullRequest.Commits
    Usta.UI.Pages.PullRequest.Conversation
    Usta.UI.Pages.PullRequest.Files
    Usta.UI.Pages.PullRequests
    Usta.UI.Pages.Repositories
    Usta.UI.Pages.Settings
    Usta.UI.Pages.Welcome
    Usta.UI.Platform
    Usta.UI.Sidebar
    Usta.UI.Style
    Usta.UI.Window

  build-depends:
    aeson,
    async,
    base,
    bytestring,
    containers,
    directory,
    esqueleto,
    filepath,
    gi-glib,
    gi-gtk4,
    gi-pango,
    haskell-gi-base,
    http-api-data,
    http-client,
    http-client-tls,
    monad-logger,
    persistent,
    persistent-sqlite,
    resourcet,
    servant,
    servant-client,
    stm,
    text,
    time,
    typed-process

  default-language: GHC2024
  ghc-options: -Wall
